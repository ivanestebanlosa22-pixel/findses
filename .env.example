# === VideoAgent AI - Environment Variables ===

# --- App ---
APP_NAME=VideoAgent AI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-secure-random-key
API_PREFIX=/api/v1

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./storage/videoagent.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/videoagent

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# --- ElevenLabs (Voice) ---
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2

# --- Replicate (Image Generation) ---
REPLICATE_API_KEY=your-replicate-api-key
REPLICATE_IMAGE_MODEL=stability-ai/stable-diffusion-3.5-large

# --- Storage ---
STORAGE_BASE_PATH=./storage
MAX_VIDEO_DURATION=300
MAX_FILE_SIZE_MB=500

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- FindsES: enlaces que salen en los vídeos y descripciones ---
WEB_URL=https://www.chinabuyhub.com/
SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/1BqVU-a3KyK0Xvj1Vh0foH2T1Htfv9qNSmLxO_ELBu0c/edit
# --- Subida a YouTube ---
YOUTUBE_CLIENT_SECRET=client_secret.json
